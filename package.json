{
  "name": "dnd-classes-5e-2014",
  "version": "1.0.0",
  "description": "Complete JSON dataset and static site for every D&D 5e (2014 rules) class and subclass.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate.mjs",
    "check": "node scripts/validate.mjs && node scripts/build.mjs",
    "serve": "node --run build && node -e \"import('node:http').then(({default:h})=>import('node:fs').then(({default:f})=>h.createServer((q,s)=>{let p='docs'+(q.url==='/'?'/index.html':q.url.split('?')[0]);try{const t=p.endsWith('.css')?'text/css':p.endsWith('.md')?'text/plain':'text/html';s.writeHead(200,{'Content-Type':t});s.end(f.readFileSync(p))}catch{s.writeHead(404);s.end('Not found')}}).listen(8080,()=>console.log('http://localhost:8080'))))\""
  },
  "engines": {
    "node": ">=18"
  }
}
